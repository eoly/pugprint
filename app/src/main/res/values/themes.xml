<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window theme under Compose; PugPrintTheme paints everything on top of it. -->
    <style name="Theme.PugPrint" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      What the launcher activity wears until Compose draws its first frame: the pug printing a
      sticker (avd_pug_splash) on PugPrint blue. Android 12+ plays the animated icon itself and
      MainActivity holds the splash until it finishes; older versions show the static frame.
    -->
    <style name="Theme.PugPrint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_pug_splash</item>
        <!-- Android 12/12L need the length spelled out; 13+ reads it from the drawable. -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.PugPrint</item>
    </style>
</resources>
